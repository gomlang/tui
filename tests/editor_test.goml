package tests;

use ecosystem::tui;
use ecosystem::terminal;
use std::testing;

fn key(code: terminal::KeyCode) -> terminal::Event {
    terminal::Event::Key(terminal::KeyEvent { code, modifiers: terminal::Modifiers::none() })
}

fn editor(text: string) -> tui::Editor {
    testing::expect_ok(tui::Editor::new(text, 1024), "editor")
}

#[test]
fn editor_deletes_whole_graphemes_and_undo_redo_restores_selection() -> () {
    let value = editor("a👩‍💻é");
    testing::expect_ok(value.update(key(terminal::KeyCode::Backspace)), "backspace accent");
    testing::assert_eq(value.text(), "a👩‍💻");
    testing::expect_ok(value.update(key(terminal::KeyCode::Backspace)), "backspace emoji");
    testing::assert_eq(value.text(), "a");
    testing::assert(value.undo());
    testing::assert_eq(value.text(), "a👩‍💻");
    testing::assert(value.redo());
    testing::assert_eq(value.text(), "a");
    testing::expect_ok(value.insert("́"), "combining insert");
    testing::assert_eq(value.cursor(), "á".byte_len());
    testing::assert(value.set_cursor(1, false).is_err());
    testing::expect_ok(value.set_cursor(0, false), "start");
    testing::expect_ok(value.set_cursor(value.text().byte_len(), true), "select");
    testing::expect_ok(value.insert("界"), "replace");
    testing::assert_eq(value.text(), "界");
    testing::assert(value.undo());
    testing::assert(value.selection().is_some());
    value.clear_history();
    testing::assert(!value.undo());
    testing::assert(!value.redo());
}

#[test]
fn undo_deletion_restores_the_original_cursor_without_selecting_text() -> () {
    for code in[terminal::KeyCode::Backspace, terminal::KeyCode::Delete] {
        let value = editor("a👩‍💻éz");
        let before = if code == terminal::KeyCode::Backspace {
            "a👩‍💻".byte_len()
        } else {
            1
        };
        testing::expect_ok(value.set_cursor(before, false), "deletion cursor");
        testing::expect_ok(value.update(key(code)), "delete emoji");
        testing::assert_eq(value.text(), "aéz");
        testing::assert_eq(value.cursor(), 1);
        testing::assert(value.selection().is_none());
        testing::assert(value.undo());
        testing::assert_eq(value.text(), "a👩‍💻éz");
        testing::assert_eq(value.cursor(), before);
        testing::assert(value.selection().is_none());
        testing::assert(value.redo());
        testing::assert_eq(value.text(), "aéz");
        testing::assert_eq(value.cursor(), 1);
        testing::assert(value.selection().is_none());
        testing::assert(value.undo());
        testing::expect_ok(value.insert("!"), "typing after undo");
        testing::assert_eq(
            value.text(),
            if code == terminal::KeyCode::Backspace {
                "a👩‍💻!éz"
            } else {
                "a!👩‍💻éz"
            },
        );
    }
}

#[test]
fn undo_deletion_preserves_an_existing_backward_selection() -> () {
    let value = editor("a👩‍💻éz");
    let anchor = "a👩‍💻é".byte_len();
    testing::expect_ok(value.set_cursor(anchor, false), "selection anchor");
    testing::expect_ok(value.set_cursor(1, true), "backward selection");
    testing::expect_ok(value.update(key(terminal::KeyCode::Delete)), "delete selection");
    testing::assert_eq(value.text(), "az");
    testing::assert(value.undo());
    testing::assert_eq(value.text(), "a👩‍💻éz");
    testing::assert_eq(value.cursor(), 1);
    testing::assert(value.selection() == Option::Some((1, anchor)));
}

#[test]
fn editor_navigation_scrolling_and_password_rendering() -> () {
    let value = editor("ab界\nxyz\n👩‍💻!");
    testing::expect_ok(value.set_cursor(2, false), "cursor");
    testing::expect_ok(value.update(key(terminal::KeyCode::Down)), "down");
    testing::assert_eq(value.cursor(), "ab界\nxy".byte_len());
    testing::expect_ok(value.update(key(terminal::KeyCode::Home)), "home");
    testing::assert_eq(value.cursor(), "ab界\n".byte_len());
    testing::expect_ok(value.update(key(terminal::KeyCode::End)), "end");
    testing::assert_eq(value.cursor(), "ab界\nxyz".byte_len());
    let output = buffer(4, 2);
    testing::expect_ok(
        value.render(output, output.area(), tui::EditorOptions::defaults()),
        "render",
    );
    testing::assert_eq(output.lines()[1], "xyz ");
    let secret = editor("a界👩‍💻");
    testing::expect_ok(
        secret.render(
            output,
            output.area(),
            tui::EditorOptions {
                password: true,
                multiline: false,
                ..tui::EditorOptions::defaults(),
            },
        ),
        "password",
    );
    testing::assert_eq(output.lines()[0], "••• ");
    testing::assert(!output.lines().join("").contains("界"));
}

#[test]
fn editor_limits_are_atomic_and_history_is_bounded() -> () {
    let value = testing::expect_ok(tui::Editor::new("abc", 4), "limited");
    testing::assert(value.insert("界").is_err());
    testing::assert_eq(value.text(), "abc");
    testing::expect_ok(value.insert("d"), "full");
    testing::assert(value.set_text("too long").is_err());
    testing::assert_eq(value.text(), "abcd");
    let history = editor("");
    for _ in 0..100 {
        testing::expect_ok(history.insert("x"), "history");
    }
    let mut count = 0;
    while history.undo() {
        count += 1;
    }
    testing::assert_eq(count, 64);
    testing::assert_eq(history.text().byte_len(), 36);
}

#[test]
fn editor_crlf_normalization_and_newline_cursor_are_visible() -> () {
    let value = editor("a\r\nb");
    testing::assert_eq(value.text(), "a\nb");
    testing::expect_ok(value.set_cursor(1, false), "newline cursor");
    let output = buffer(4, 2);
    let options = tui::EditorOptions::defaults();
    testing::expect_ok(value.render(output, output.area(), options), "newline caret");
    testing::assert_eq(cell(output, 1, 0).style, options.cursor_style);
}

#[test]
fn editor_vertical_navigation_uses_tab_stops() -> () {
    let value = editor("\tX\nabcdefghi");
    testing::expect_ok(value.set_cursor(2, false), "first line column nine");
    testing::expect_ok(value.update(key(terminal::KeyCode::Down)), "down");
    testing::assert_eq(value.cursor(), value.text().byte_len());
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "up");
    testing::assert_eq(value.cursor(), 2);
}

#[test]
fn editor_scrolls_the_whole_wide_cursor_grapheme_into_view() -> () {
    for glyph in["界", "👩‍💻"] {
        let value = editor("abc" + glyph + "z");
        let output = testing::expect_ok(tui::Buffer::new(4, 1), "wide cursor buffer");
        let options = tui::EditorOptions::defaults();
        testing::assert_ok(value.set_cursor(0, false));
        testing::assert_ok(value.render(output, output.area(), options));
        testing::assert_ok(value.set_cursor(3, false));
        testing::assert_ok(value.render(output, output.area(), options));
        testing::assert_eq(output.lines().join(""), "bc" + glyph);
        testing::assert_eq(cell(output, 2, 0).style, options.cursor_style);
        testing::assert_eq(cell(output, 3, 0).style, options.cursor_style);
        testing::assert(cell(output, 3, 0).continuation);
        testing::assert_ok(output.validate());
    }
}

#[test]
fn editor_clipped_wide_cells_keep_cursor_and_selection_styles() -> () {
    let value = editor("界X");
    let output = testing::expect_ok(tui::Buffer::new(4, 3), "clipped cursor buffer");
    let options = tui::EditorOptions::defaults();
    let area = tui::Rect { x: 1, y: 1, width: 1, height: 1 };
    testing::assert_ok(value.set_cursor(0, false));
    testing::assert_ok(value.render(output, area, options));
    testing::assert_eq(cell(output, 1, 1).text, " ");
    testing::assert_eq(cell(output, 1, 1).style, options.cursor_style);
    testing::assert_ok(value.set_cursor(3, true));
    testing::assert_ok(value.render(output, tui::Rect { width: 2, ..area }, options));
    testing::assert_eq(cell(output, 1, 1).text, " ");
    testing::assert_eq(cell(output, 1, 1).style, options.selection_style);
    testing::assert_eq(cell(output, 2, 1).text, "X");
    testing::assert_eq(cell(output, 2, 1).style, options.cursor_style);
    testing::assert_eq(cell(output, 0, 1).style, options.style);
    testing::assert_eq(cell(output, 3, 1).style, options.style);
    testing::assert_ok(output.validate());
}

#[test]
fn replacing_identical_selected_text_collapses_selection() -> () {
    let value = editor("abc");
    testing::expect_ok(value.set_cursor(0, false), "anchor");
    testing::expect_ok(value.set_cursor(3, true), "select");
    testing::expect_ok(value.insert("abc"), "replace same text");
    testing::assert(value.selection().is_none());
    testing::assert_eq(value.cursor(), 3);
    testing::assert(!value.undo());
}

#[test]
fn undo_redo_share_one_history_byte_budget() -> () {
    let value = testing::expect_ok(tui::Editor::new("", 1048576), "large editor");
    for text in[
        "a".repeat(1048576),
        "b".repeat(1048576),
        "c".repeat(1048576),
        "d".repeat(1048575),
        "e",
        "f".repeat(1048576),
    ] {
        testing::expect_ok(value.set_text(text), "history text");
    }
    let mut undos = 0;
    while value.undo() {
        undos += 1;
    }
    testing::assert_eq(undos, 4);
    let mut redos = 0;
    while value.redo() {
        redos += 1;
    }
    testing::assert_eq(redos, 4);
}

#[test]
fn vertical_navigation_restores_the_preferred_display_column() -> () {
    let value = editor("abcdef\nx\n中\n\tZ\nabcdef");
    testing::expect_ok(value.set_cursor(5, false), "column five");
    for expected in["abcdef\nx", "abcdef\nx\n中", "abcdef\nx\n中\n", "abcdef\nx\n中\n\tZ\nabcde"] {
        testing::expect_ok(value.update(key(terminal::KeyCode::Down)), "down");
        testing::assert_eq(value.cursor(), expected.byte_len());
    }
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "up to tab");
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "up to wide short line");
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "up to short line");
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "up to first line");
    testing::assert_eq(value.cursor(), 5);
    testing::expect_ok(value.update(key(terminal::KeyCode::Down)), "short line");
    testing::expect_ok(value.update(key(terminal::KeyCode::Left)), "reset preference");
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "new column");
    testing::assert_eq(value.cursor(), 0);
    testing::expect_ok(value.set_cursor(5, false), "restore column");
    testing::expect_ok(value.update(key(terminal::KeyCode::Down)), "short line");
    testing::expect_ok(value.insert("y"), "edit resets preference");
    testing::expect_ok(value.update(key(terminal::KeyCode::Up)), "edited column");
    testing::assert_eq(value.cursor(), 2);
}
